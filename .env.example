# Skopiuj do .env (lokalnie) lub ustaw jako GitHub Secrets / zmienne w Task Scheduler.
# NIE commituj .env z prawdziwymi hasłami.

# --- Tryb discovery-only (domyślnie WŁĄCZONY) ---
# Maile B2B do kontrahentów: 1 = wyłączone (NO-OP), 0 = włącz wysyłkę
DISABLE_CONTRACTOR_EMAILS=1
# Google Drive upload/sync/download: 1 = wyłączone, 0 = włącz
DISABLE_GOOGLE_DRIVE=1
# Raport wewnętrzny Excel na Gmail (NIE B2B): 0 = włączony (jeden odbiorca EXCEL_REPORT_TO)
DISABLE_EXCEL_REPORT_EMAIL=0
# Jeden odbiorca końcowego Excela:
EXCEL_REPORT_TO=svinchak1993@gmail.com

# --- Harmonogram wysyłki (dowolna godzina startu, np. 2:00 w nocy) ---
# Wyłącza okno 8–18 — zalecane dla GitHub Actions i nocnego cron:
DISABLE_SEND_WINDOW=1
# Alternatywnie: cała doba bez wyłączania flagi:
# SEND_WINDOW_START_HOUR=0
# SEND_WINDOW_END_HOUR=24
# Strefa dla okna (gdy DISABLE_SEND_WINDOW=0):
SCRAPER_TIMEZONE=Europe/Warsaw

# --- Poczta (potrzebna gdy DISABLE_CONTRACTOR_EMAILS=0 lub raport Excel włączony) ---
MAIL_USER=
MAIL_PASSWORD=
MAIL_SENDER_NAME=
# Opcjonalna widoczna kopia (bez automatycznego office@mfg-fliesen.de):
# MAIL_CC=
# Alternatywa SMTP dla raportu Excel na GHA:
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# --- API ---
SERPER_API_KEY=
ANTHROPIC_API_KEY=
# Limit Serper (domyślnie 1000 / dzień; GHA ustawia 1000):
# SERPER_DAILY_LIMIT=1000
# Modele Claude (domyślnie haiku / sonnet — patrz docs/GITHUB_ACTIONS.md):
# CLAUDE_MODEL_FAST=claude-haiku-4-5
# CLAUDE_MODEL_VERIFY=claude-sonnet-4-6

# Cadence GHA (tylko guard w Actions — lokalnie nie dotyczy):
# GU_CADENCE_ANCHOR=2026-09-21
# GU_CADENCE_DAYS=42

# Ścieżka do bibliotek kampanii (scraper_env, polish_text, …)
# Lokalnie z korzenia repo:
KANBUD_PROJECT_ROOT=

# Wyniki GU — lokalnie w folderze kampanii (Wyniki/). Drive OFF by default.
# Przy DISABLE_GOOGLE_DRIVE=0 możesz wskazać zsynchronizowany folder:
# https://drive.google.com/drive/folders/1tP8oUi72t4EHDbE9GnHFdvfNtNsJe4xf
# KANBUD_GOOGLE_DRIVE_GU_PATH=G:\Mój dysk\GU Bauunternehmen Wyniki
# KANBUD_DATA_DIR=C:\path\to\local\data

# Załącznik PPTX do maili DE (tylko gdy maile B2B włączone; bez Drive = lokalny plik)
# https://docs.google.com/presentation/d/1kBnp5x0pdgXZSPzVte9e92IUgn2A5gSe/edit
# MFG_EMAIL_ATTACHMENT_PATH=assets/campaign/MFG_Referenzliste_Einzelhandel.pptx

# Google Drive (OPCJONALNE / OFF) — pliki w secrets/, NIE commituj do git:
# Wymaga DISABLE_GOOGLE_DRIVE=0
# scripts\map_gdrive_secrets.ps1  — kopiuje JSON z Pobranych
# GDRIVE_SERVICE_ACCOUNT_FILE=secrets/gdrive-service-account.json
# OAuth Desktop (upload na Moj dysk): secrets/gdrive-oauth-client.json + python scripts/gdrive_oauth_setup.py
# GHA nd 09:00: GDRIVE_FOLDER_ID + GDRIVE_OAUTH_* (patrz docs/GOOGLE_DRIVE.md)
